<- notable.
# List filters compiled natively: `%` (floored, as Haskell's mod), guards
# of the form `k is E`, and clauses told apart only by guards on the same
# expression (`0 is I % P` against `X is I % P, X != 0`). Answers, their
# order, bindings and errors must match the reference engine exactly.

remove _ [] [].
remove P [I | Is] Nis <- 0 is I % P, remove P Is Nis.
remove P [I | Is] [I | Nis] <- X is I % P, X != 0, remove P Is Nis.

# A literal other than 0, and a comparison on the defined variable.
odds [] [].
odds [I | Is] [I | Os] <- 1 is I % 2, odds Is Os.
odds [I | Is] Os <- X is I % 2, X < 1, odds Is Os.

# Not exclusive: two different divisors, so both clauses can match.
both _ _ [] [].
both P Q [I | Is] Os <- 0 is I % P, both P Q Is Os.
both P Q [I | Is] [I | Os] <- X is I % Q, X != 0, both P Q Is Os.

# Not exclusive either: != against an unevaluated expression is
# structural, so `I % P != 0` always holds.
loose _ [] [].
loose P [I | Is] Os <- 0 is I % P, loose P Is Os.
loose P [I | Is] [I | Os] <- I % P != 0, loose P Is Os.

# `%` in a counting loop.
count_mult _ 0 C C.
count_mult P N C0 C <- N > 0, 0 is N % P, C1 is C0 + 1, N1 is N - 1, count_mult P N1 C1 C.
count_mult P N C0 C <- N > 0, X is N % P, X != 0, N1 is N - 1, count_mult P N1 C0 C.

range N N [N].
range I N [I | T] <- I < N, I1 is I + 1, range I1 N T.
sieve [] [].
sieve [P | Xs] [P | Ys] <- remove P Xs Zs, sieve Zs Ys.
primes N Ps <- range 2 N L, sieve L Ps.
len [] 0.
len [_ | T] N <- len T M, N is M + 1.

> remove 3 [1, 2, 3, 4, 5, 6, 7] L?
> remove 3 [] L?
> remove 1 [5, 6] L?
> findall L (remove 3 [3, 4, 9, 10] L) R?
# Floored modulus: the sign follows the divisor.
> remove 3 [-7, -6, -5, -4, -3, -2, -1, 0, 1] L?
> remove -3 [-7, -6, -5, -4, -3, -2, -1, 0, 1, 2, 7] L?
> X is -7 % 3, Y is 7 % -3, Z is -7 % -3?
> count_mult -4 20 0 C?
> count_mult 3 30 0 C?
# A zero divisor raises the same error.
> remove 0 [1, 2] L?
> remove 0 [] L?
# Values the native code does not handle go to the interpreter.
> remove 2 [1, 2, x, 4] L?
> remove 2 [1, 2.0, 3] L?
> remove 2.0 [1, 2] L?
> remove 2 [1180591620717411303424, 3, 4] L?
> remove 5 [1180591620717411303425, 3, 1180591620717411303426] L?
> once (remove 2 [1, 2, 3 | T] L)?
> remove 2 [1, X, 3] L?
> remove X [1, 2] L?
# A bound output.
> remove 2 [1, 2, 3, 5] [1, 3, 5]?
> remove 2 [1, 2, 3, 5] [1, 3]?
> remove 2 [1, 2, 3] [A, B]?
> remove 2 [1, 2, 3] [A | T]?
# Other guard forms.
> odds [1, 2, 3, 4, 5, -1, -2] L?
> findall L (both 2 3 [6, 4, 9, 5] L) R?
> findall L (both 2 3 [6, 4, 5] L) R?
> findall L (loose 2 [4, 5] L) R?
# A sieve, as in the primes benchmark.
> primes 50 Ps?
> findall N (primes 3000 Ps, len Ps N) R?
> findall P (primes 30 P) R?
