<- notable.
# List searches run by the native scan kernel (mem/2, right_of/3 and other
# predicates of the same shape). The kernel tries the base clause's head at
# each list position, undoing failed attempts from the trail, and returns at
# each match with a choice point that resumes with the step clause. It bails
# to the interpreter on unbound tails, nested structures, boxed constants
# and a full trail. Answers, their order and their bindings must match the
# reference engine exactly.

mem X [X | _].
mem X [_ | T] <- mem X T.

right_of X Y [Y, X | _].
right_of X Y [_ | T] <- right_of X Y T.
next_to X Y L <- right_of X Y L.
next_to X Y L <- right_of Y X L.

# Repeated and skipped elements in the base clause's prefix.
twin X [X, X | _].
twin X [_ | T] <- twin X T.
second X [_, X | _].
second X [_ | T] <- second X T.

# The list argument first, and an argument the base clause ignores.
member_of [X | _] X.
member_of [_ | T] X <- member_of T X.
tagged K X [X | _].
tagged K X [_ | T] <- tagged K X T.

# Not list searches: the step clause first, or a third clause.
rmem X [_ | T] <- rmem X T.
rmem X [X | _].
mem3 X [X | _].
mem3 X [_ | T] <- mem3 X T.
mem3 X done.

# A search inside a clause body, with a cut after it.
first_big : unsafe.
first_big X L <- mem X L, X > 2, !.

# Every binding the kernel makes is trailed, so a long loop with no
# collection fills the trail: the kernel must bail before a binding it
# cannot trail (here X = 1 would survive the failed first element).
fill 0.
fill K <- K > 0, mem (h X 2) [h 1 3, h 5 2], X == 5, K1 is K - 1, fill K1.

# Several searches over one list of houses, as in zebra.
houses Hs <-
  Hs = [h _ norwegian _, _, h _ _ milk],
  mem (h red english _) Hs,
  mem (h green _ coffee) Hs,
  right_of (h green _ _) (h ivory _ _) Hs.

> mem 3 [1, 2, 3, 4, 3]?
> mem 9 [1, 2, 3]?
> mem X []?
> mem X nope?
> findall X (mem X [a, b, c]) L?
> findall X (mem X [a, b | c]) L?
> mem (h A b) [h 1 a, h 2 b, h 3 b]?
> findall A (mem (h A b) [h 1 a, h 2 b, h 3 b]) L?
> findall (pr A B) (mem (h A B) [h 1 a, g 2 b, h 3 c]) L?
> mem (h A A) [h 1 2, h 3 3, h 4 4]?
> mem (h A B) [h 1 2], A = 1, B = 2?
> L = [h A 1, h 2 B], mem (h C C) L?
> not (mem 9 [1, 2, 3])?
> not (mem 2 [1, 2, 3])?
# Variables against variables: the younger is bound to the older.
> mem X [Y]?
> mem X [Y], X = 1?
> X = f A, mem (f B) [X], B = 1?
> mem (g X Y) [g Y X], X = 1?
# Unbound tails: the interpreter extends the list.
> once (mem X [p | T])?
> once (mem q [p | T])?
> once (mem q T)?
> once (findall T (once (mem q [a, b | T])) R)?
> L = [a | T], once (mem b L), T = [b | _]?
# Nested structures, boxed constants and the occurs check.
> mem (f (g X)) [f (g 1), f (g 2)]?
> findall Z (mem Z [f (g 1), f (g 2)]) L?
> mem (f X) [f (g 1)]?
> mem [1, X] [[1, 2], [1, 3]]?
> mem 1.5 [1.0, 1.5]?
> mem "ab" ["a", "ab"]?
> mem 1180591620717411303424 [1, 1180591620717411303424]?
> mem X [f X]?
> mem (f X) [X]?
> X = f Y, mem Y [a, X]?
> X = f Y, mem (g X) [g Y]?
> mem (f a Y) [Y]?
> mem (f (g Y)) [Y]?
> mem (f (g a)) [Y]?
> mem (f X) [Y, f 1], X = 1?
# Under constraints the kernel declines.
> X in 1 .. 5, mem X [7, 3, 9, 4], label [X]?
> X in 1 .. 5, findall X (mem X [7, 3, 9, 4]) L?
# Prefixes of two elements, repeats and skips.
> findall (pr X Y) (right_of X Y [1, 2, 3, 4]) L?
> right_of 3 Y [1, 2, 3, 4]?
> right_of X Y [1]?
> once (right_of X Y [1 | T])?
> findall (pr X Y) (next_to X Y [1, 2, 3]) L?
> findall X (twin X [a, b, b, c, c, c]) L?
> findall X (second X [1, 2, 3]) L?
> findall X (member_of [a, b] X) L?
> findall X (tagged k X [a, b]) L?
> tagged K X [a]?
> findall X (rmem X [a, b, c]) L?
> findall X (mem3 X [a, b | done]) L?
# Cuts, findall and nesting.
> first_big X [1, 3, 5]?
> findall X (first_big X [1, 3, 5]) L?
> once (mem X [p, q])?
> findall (pr X Y) (mem X [1, 2], mem Y [2, 1], X == Y) L?
> findall (pr X Y) (mem X [1, 2], not (mem X [2]), mem Y [X]) L?
> fill 10000?
> houses Hs?
> findall Hs (houses Hs) L?
