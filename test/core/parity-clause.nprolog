<- notable.
# The clause compiler (docs/2026-11-06-CLAUSE-COMPILER.md, increment 1):
# whole predicates in native code, with calls between them, frames on a
# native stack, structures built and matched, and clause selection that
# commits only where no later clause could match.

# Non-tail double recursion with arithmetic around the calls.
fib 0 0.
fib 1 1.
fib N F <- N > 1, N1 is N - 1, N2 is N - 2, fib N1 F1, fib N2 F2, F is F1 + F2.

# A non-tail call, then arithmetic on its result.
len [] 0.
len [_ | T] N <- len T M, N is M + 1.

# A call to another predicate of the unit, then a last call.
remove _ [] [].
remove P [I | Is] Nis <- 0 is I % P, remove P Is Nis.
remove P [I | Is] [I | Nis] <- X is I % P, X != 0, remove P Is Nis.
sieve [] [].
sieve [P | Xs] [P | Ys] <- remove P Xs Zs, sieve Zs Ys.
upto N N [N].
upto I N [I | T] <- I < N, I1 is I + 1, upto I1 N T.

# Mutual recursion.
even 0.
even N <- N > 0, M is N - 1, odd M.
odd N <- N > 0, M is N - 1, even M.

# Building and matching nested structures.
expr E <- E = add (add (pw x 3) (times 4 (pw x 2))) (sub (times 7 x) 9).
deep E <- E = t (t (t (t (t (t (t (t (t x x) x) x) x) x) x) x) x) x.
wrap X (f X (g X)).
unwrap (f A (g B)) A B.
pair X Y (p X Y).
swap (p X Y) (p Y X).
swapall [] [].
swapall [P | Ps] [Q | Qs] <- swap P Q, swapall Ps Qs.

# A repeated head variable: unification without a walk where possible.
same X X.
twice X [X, X].

# Atoms and characters in heads, and a structure selected by functor.
kind red warm.
kind blue cool.
kind 'c' letter.
area (sq S) A <- A is S * S.
area (rect W H) A <- A is W * H.
area (tri B H) A <- A is B * H % 1000.
areas [] 0.
areas [S | Ss] T <- area S A, areas Ss T0, T is T0 + A.

# Overlapping clauses: the interpreter commits on the first answer only
# when the switch argument is ground, and native code must match it.
cls 0 zero.
cls N small <- N < 10.
cls N big <- N >= 10.

# Guards on an argument that an alias can bind.
sgn X 1 <- X > 0.
sgn X -1 <- X <= 0.

# Structural != decided natively only on constants.
diff X Y <- X != Y.

# Increment 2: inline type/groundness tests, structural equality, cuts,
# once, negation-as-failure, and native choice-frame backtracking.
classify X int <- is_int X.
classify X atom <- is_atom X.
classify X char <- is_char X.
classify X open <- var X.
classify X comp <- nonvar X, not (is_int X), not (is_atom X), not (is_char X).

check_ground X ok <- ground X, nonvar X.
check_ground X open <- not (ground X).

eq_test A B same <- A == B.
eq_test A B diff <- not (A == B).

match_target X hit <- X == p a (g 3).
match_target X miss <- not (X == p a (g 3)).

first_pos : unsafe.
first_pos [X | _] X <- X > 0, !.
first_pos [_ | T] R <- first_pos T R.

sel X [X | T] T.
sel X [H | T] [H | R] <- sel X T R.
perm [] [].
perm L [H | T] <- sel H L R, perm R T.

once_pick L X <- once (sel X L _), X > 1.
has_even L <- sel X L _, 0 is X % 2.
no_even L <- not (has_even L).

d (add U V) X (add DU DV) <- d U X DU, d V X DV.
d (sub U V) X (sub DU DV) <- d U X DU, d V X DV.
d (times U V) X (add (times DU V) (times U DV)) <- d U X DU, d V X DV.
d (quo U V) X (quo (sub (times DU V) (times U DV)) (pw V 2)) <- d U X DU, d V X DV.
d (pw U N) X (times DU (times N (pw U N1))) <- is_int N, N1 is N - 1, d U X DU.
d (neg U) X (neg DU) <- d U X DU.
d X X 1.
d C X 0 <- ground C, not (C == X).

# A long list for len/2, whose non-tail recursion grows the native stack
# (3000 frames of about 7 words against 4096 initial words). count/2 itself
# is a tail loop kernel. Open-ended queries are under once: parity
# enumerates every answer.
count 0 [].
count N [N | T] <- N > 0, M is N - 1, count M T.

> fib 0 F?
> fib 1 F?
> fib 15 F?
> fib 23 F?
> fib 10 55?
> fib 10 54?
> fib 0 1?
> fib N 1?
> fib -1 F?
> fib a F?
> len [] N?
> len [a, b, c] N?
> once (len [a, b | T] N)?
> once (len L 2)?
> len [a, b] 3?
> upto 2 30 L, sieve L P?
> sieve [2, 3, 4, 5, 6, 7, 8, 9, 10] P?
> sieve [] P?
> sieve [0, 3] P?
> sieve [3, 0, 6] P?
> remove 0 [1, 2] L?
> remove 3 [3, 4, 9, 1] [4, 1]?
> remove 3 [3, 4, 9, 1] [4]?
> even 10?
