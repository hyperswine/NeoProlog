<- notable.
cost a 3. cost b 1. cost c 2. cost d 1.
best X <- minimize C (cost X C).
noisy : unsafe.
noisy X C <- writeln X, cost X C.
loud_best : unsafe.
loud_best X <- minimize C (noisy X C).
> best X?
> minimize C (cost X C), C < 2?
> minimize C (cost X C, C > 5)?
> minimize C (cost X C ; C = foo)?
> minimize C (X = 1)?
> minimize C (C = 2.5)?
> minimize C ((C = 1, X = a ; C = 1, X = b))?
> loud_best X?
> findall X (best X) L?
> minimize (A + B) ((A = 2, B = 2 ; A = 1, B = 2 ; A = 3, B = 0)), S is A + B?
> minimize C (cost X C, (X = a -> fail ; true))?
> not (minimize C (cost X C, C > 5))?
> minimize C (cost X C), minimize D (cost Y D), X = Y?
