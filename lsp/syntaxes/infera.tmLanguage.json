{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Infera",
  "scopeName": "source.infera",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#char" },
    { "include": "#number" },
    { "include": "#directive" },
    { "include": "#declaration" },
    { "include": "#query" },
    { "include": "#head" },
    { "include": "#neck" },
    { "include": "#operator" },
    { "include": "#variable" },
    { "include": "#builtin" },
    { "include": "#qualified" },
    { "include": "#atom" }
  ],
  "repository": {
    "comment": {
      "match": "#(?![=!<>]).*$",
      "name": "comment.line.number-sign.infera"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.infera",
      "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.infera" }]
    },
    "char": {
      "match": "'(\\\\.|[^'])'",
      "name": "string.quoted.single.infera"
    },
    "number": {
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.infera"
    },
    "directive": {
      "match": "^\\s*(<-)\\s*(import|table|notable|index|noindex)\\b",
      "captures": {
        "1": { "name": "keyword.control.infera" },
        "2": { "name": "keyword.control.directive.infera" }
      }
    },
    "declaration": {
      "begin": "^\\s*([a-z][A-Za-z0-9_]*)\\s+(:)(?![:-])",
      "end": "\\.",
      "beginCaptures": {
        "1": { "name": "entity.name.function.declaration.infera" },
        "2": { "name": "keyword.operator.infera" }
      },
      "patterns": [
        { "match": "\\b(det|semidet|multi|nondet)\\b", "name": "keyword.other.determinism.infera" },
        { "match": "\\b(table|notable|index|noindex|unsafe|dynamic)\\b", "name": "keyword.other.flag.infera" },
        { "match": "\\b(int|float|num|str|char|atom|any|list)\\b", "name": "support.type.infera" },
        { "match": "<=>|<=|=>", "name": "keyword.operator.mode.infera" },
        { "match": "_", "name": "support.type.infera" }
      ]
    },
    "query": {
      "match": "^\\s*(>)",
      "captures": { "1": { "name": "keyword.control.query.infera" } }
    },
    "head": {
      "match": "^\\s*([a-z][A-Za-z0-9_]*)(?=\\s|\\.|<-|->|$)",
      "captures": { "1": { "name": "entity.name.function.infera" } }
    },
    "neck": {
      "match": "<-|->|!",
      "name": "keyword.control.infera"
    },
    "operator": {
      "match": "#>=|#<=|#!=|#=|#<|#>|::|\\.\\.|>=|<=|==|!=|[-+*/%^<>=;|,]|\\bis\\b|\\bin\\b",
      "name": "keyword.operator.infera"
    },
    "variable": {
      "match": "\\b[A-Z_][A-Za-z0-9_]*\\b",
      "name": "variable.other.infera"
    },
    "builtin": {
      "match": "\\b(true|fail|false|nl|write|writeln|print|call|not|once|forall|findall|minimize|reify|phrase|label|labeling|all_different|all_distinct|var|nonvar|ground|is_int|is_float|is_num|is_str|is_atom|is_char|is_list|str_concat|str_length|str_chars|str_atom|str_num|str_upper|str_lower|emit|read_file|phrase_from_file|assert|retract|retractall|seq|wr|sp|fmt|padl|padr|term_str|str_lines|char_code)\\b",
      "name": "support.function.builtin.infera"
    },
    "qualified": {
      "match": "\\b([a-z][A-Za-z0-9_]*)(:)([a-z][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "entity.name.namespace.infera" },
        "2": { "name": "keyword.operator.infera" },
        "3": { "name": "entity.name.function.infera" }
      }
    },
    "atom": {
      "match": "\\b[a-z][A-Za-z0-9_]*\\b",
      "name": "entity.name.function.call.infera"
    }
  }
}
