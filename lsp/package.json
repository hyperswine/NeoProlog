{
  "name": "infera-lsp",
  "displayName": "Infera",
  "description": "Language support for Infera v2 (.nprolog / .infera): highlighting, hover, navigation, completion, diagnostics and module-aware go-to-definition.",
  "version": "2.0.4",
  "publisher": "hyperswine",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperswine/NeoProlog.git",
    "directory": "lsp"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "infera",
    "nprolog",
    "prolog",
    "logic programming"
  ],
  "main": "./client/extension.js",
  "activationEvents": [
    "onLanguage:infera"
  ],
  "contributes": {
    "languages": [
      {
        "id": "infera",
        "aliases": [
          "Infera",
          "NProlog"
        ],
        "extensions": [
          ".nprolog",
          ".infera"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "infera",
        "scopeName": "source.infera",
        "path": "./syntaxes/infera.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Infera",
      "properties": {
        "infera.executable": {
          "type": "string",
          "default": "infera",
          "description": "Path to the infera executable used for compiler diagnostics of live editor buffers."
        },
        "infera.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run the compiler checker on save (also on open when this or checkOnChange is enabled)."
        },
        "infera.checkOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Run the compiler checker on unsaved edits, after a short debounce."
        },
        "infera.performanceHints": {
          "type": "boolean",
          "default": true,
          "description": "Show compiler performance suggestions (perf-* diagnostics). Correctness diagnostics and unsafe/dynamic highlighting remain enabled."
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "infera",
        "scopes": {
          "type": [
            "support.type.infera"
          ],
          "namespace": [
            "entity.name.namespace.infera"
          ]
        }
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "unsafe",
        "description": "A predicate declared unsafe or an effectful built-in call."
      },
      {
        "id": "dynamic",
        "description": "A predicate declared dynamic."
      }
    ],
    "configurationDefaults": {
      "[infera]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "*.unsafe:infera": {
            "underline": true
          },
          "*.dynamic:infera": {
            "underline": true
          }
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package",
    "install-extension": "vsce package -o infera-lsp.vsix && code --install-extension infera-lsp.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
