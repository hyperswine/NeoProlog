foldl : nondet notable (any: <=>) (any: <=>) (any: <=>) (any: <=>) (any: <=>) (any: <=>).
include : nondet notable (any: <=>) (any: <=>) (any: <=>).
exclude : nondet notable (any: <=>) (any: <=>) (any: <=>).
