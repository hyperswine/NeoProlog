# ─── Infera v2: CLP(Z) ───────────────────────────────────────────────────────
#
#   X in Lo..Hi          restrict to an interval (inf / sup for open ends);
#                        a list on the left restricts every element
#   A #= B  A #!= B      integer (dis)equality
#   A #< B  A #> B  A #<= B  A #>= B
#   all_different Xs     pairwise #!=
#   label Xs             enumerate finite domains (smallest domain first)
#
# Bounds propagation runs after every unification and constraint; residual
# domains and constraints are shown in answers.

# Two equations, solved by propagation once labeling fixes one variable.
# simple puzzle: find two numbers X and Y such that their sum is 10 and their difference is 2.
puzzle X Y <- [X, Y] in 0..20, X + Y #= 10, X - Y #= 2, label [X, Y].

# SEND + MORE = MONEY
send_more_money [S, E, N, D, M, O, R, Y] <-
  Vars = [S, E, N, D, M, O, R, Y],
  Vars in 0..9,
  all_different Vars,
  # S and M cant be 0 because they are the leading digits of their respective numbers.
  S #!= 0,
  M #!= 0,
  1000 * S + 100 * E + 10 * N + D + 1000 * M + 100 * O + 10 * R + E
    #= 10000 * M + 1000 * O + 100 * N + 10 * E + Y,
  label Vars.

# N-queens with constraints.
queens N Qs <- mklist N Qs, Qs in 1..N, safe Qs, label Qs.

mklist 0 [].
mklist N [_ | T] <- N > 0, N1 is N - 1, mklist N1 T.

safe [].
safe [Q | Qs] <- noattack Q Qs 1, safe Qs.

# basically, queens are not in each other's line of attack (same row, same column, or same diagonal)
noattack _ [] _.
noattack Q [Q1 | Qs] D <-
  Q #!= Q1, Q #!= Q1 + D, Q #!= Q1 - D,
  D1 is D + 1,
  noattack Q Qs D1.

> X #= 3 + 4?
> 3 #= X + 1?
> X #> 3, X #< 6?
> X in 1..3, label [X]?
> X in 0..5, Y in 0..5, X + Y #= 10?
> X + Y #= 10?
> puzzle X Y?
> send_more_money L?
> queens 6 Qs?
