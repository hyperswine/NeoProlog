# ─── Breadboard placer: circuit nets → 170-tie breadboard wiring ─────────────
#
# A pure-Infera translation of examples/bbgen.py (SPICE + clingo).
#
# Board: 17 columns; top half rows a..e, bottom half rows f..j; the five holes
# of one (column, half) are one electrical node.  Every component is a 2-pin
# part spanning two adjacent columns (pin a at Col, pin b at Col + 1) in the
# row given by its index, exactly like the Python version.
#
# What is different from bbgen.py:
#   * circuits are facts, not SPICE text (SPICE net 0 is `gnd`; `in` is an
#     operator in Infera, so use `vin`);
#   * hard constraints are CLP(Z): holes are all_different, pins on the same
#     net share a node (#=) unless that net is jumpered, and pins on
#     different nets never share a node (#!=) -- the ASP model allowed shorts;
#   * optimisation is layered search: fewest
#     jumpers first, then the narrowest column window around the centre,
#     then the lowest cramping / mixed-half score among what is left.
#     `minimize` retains only the winning placement while searching a window.
#
# Run:  infera examples/breadboard.nprolog        (or `> run rc?` in the REPL)

<- notable.

# ─── Circuits ────────────────────────────────────────────────────────────────
# comp Circuit Name Kind Value NetA NetB      (placed)
# source Circuit Name Kind Value NetA NetB    (not placed; terminals reported)

comp rc r1 r "1k" vin mid.
comp rc c1 c "100n" mid gnd.
source rc v1 v "AC 1" vin gnd.

comp div r1 r "10k" vin mid.
comp div r2 r "10k" mid gnd.
comp div c1 c "1u" mid gnd.
source div v1 v "DC 5" vin gnd.

# Three resistors in a ring: one net can only be closed with a jumper.
comp tri r1 r "1k" a b.
comp tri r2 r "1k" b c.
comp tri r3 r "1k" c a.

# ─── List helpers ────────────────────────────────────────────────────────────

member X [X | _].
member X [_ | T] <- member X T.

append [] L L.
append [H | T] L [H | R] <- append T L R.

length [] 0.
length [_ | T] N <- length T N1, N is N1 + 1.

between Lo Hi Lo <- Lo <= Hi.
between Lo Hi X <- Lo < Hi, Lo1 is Lo + 1, between Lo1 Hi X.

dedup [] [].
dedup [X | T] R <- member X T, !, dedup T R.
dedup [X | T] [X | R] <- dedup T R.

# choose K Xs Sub: Sub is a K-element sub-list of Xs (in order).
choose 0 _ [].
choose K [X | Xs] [X | S] <- K > 0, K1 is K - 1, choose K1 Xs S.
choose K [_ | Xs] S <- K > 0, choose K Xs S.

# ─── String helpers ──────────────────────────────────────────────────────────

pad_left S W Out <- str_length S L, (L >= W -> Out = S ; str_concat " " S S1, pad_left S1 W Out).
pad_right S W Out <- str_length S L, (L >= W -> Out = S ; str_concat S " " S1, pad_right S1 W Out).

join [] _ "".
join [X] _ X <- !.
join [X | T] Sep S <- join T Sep R, str_concat X Sep S1, str_concat S1 R S.

repeat_str _ 0 "" <- !.
repeat_str S N Out <- N1 is N - 1, repeat_str S N1 R, str_concat S R Out.

atom_upper A S <- str_atom S0 A, str_upper S0 S.

# ─── Circuit model ───────────────────────────────────────────────────────────
# Components get an index (1..N) and a row ((Idx - 1) mod 5 + 1).
#   c Name Kind Value NetA NetB Idx Row

comps Circuit Cs <-
  findall (c N K V A B) (comp Circuit N K V A B) Raw,
  number_comps Raw 1 Cs.

number_comps [] _ [].
number_comps [c N K V A B | T] I [c N K V A B I R | Rs] <-
  R is (I - 1) % 5 + 1, I1 is I + 1, number_comps T I1 Rs.

nets Cs Ns <- findall N (member (c _ _ _ A B _ _) Cs, (N = A ; N = B)) All, dedup All Ns.

on_net N (c _ _ _ A B _ _) <- (A == N ; B == N).

net_pins Cs N K <- findall C (member C Cs, on_net N C) L, length L K.

multi_nets Cs Ns MNs <- findall N (member N Ns, net_pins Cs N K, K >= 2) MNs.

# ─── Placement model (CLP(Z)) ────────────────────────────────────────────────
#   pl Name Kind Value NetA NetB Idx Row Col Half HoleA HoleB NodeA NodeB
#   Half: 0 = top, 1 = bottom.  Node = Half*100 + Col.  Hole = Node*10 + Row.

vars [] _ _ [].
vars [c N K V A B I R | T] Lo Hi [pl N K V A B I R Col Half HA HB NA NB | Ps] <-
  Col in Lo..Hi,
  Half in 0..1,
  NA #= Half * 100 + Col,
  NB #= Half * 100 + Col + 1,
  HA #= NA * 10 + R,
  HB #= NB * 10 + R,
  vars T Lo Hi Ps.

holes [] [].
holes [pl _ _ _ _ _ _ _ _ _ HA HB _ _ | T] [HA, HB | Hs] <- holes T Hs.

cols [] [].
cols [pl _ _ _ _ _ _ _ Col _ _ _ _ _ | T] [Col | Cs] <- cols T Cs.

halves [] [].
halves [pl _ _ _ _ _ _ _ _ Half _ _ _ _ | T] [Half | Hs] <- halves T Hs.

pins [] [].
pins [pl _ _ _ A B _ _ _ _ _ _ NA NB | T] [pin A NA, pin B NB | Ps] <- pins T Ps.

# Same net -> same node (unless the net is jumpered); different net -> different node.
connect [] _.
connect [P | T] Wired <- connect_with P T Wired, connect T Wired.

connect_with _ [] _.
connect_with (pin N1 X) [pin N2 Y | T] Wired <-
  (N1 == N2 -> (member N1 Wired -> true ; X #= Y) ; X #!= Y),
  connect_with (pin N1 X) T Wired.

solve Cs Wired Lo Hi P <-
  vars Cs Lo Hi P,
  P = [pl _ _ _ _ _ _ _ _ 0 _ _ _ _ | _],      # symmetry: first part on top
  holes P Hs, all_different Hs,
  pins P Pins, connect Pins Wired,
  cols P Cols, halves P Halves, append Cols Halves Vs,
  label Vs.

# ─── Scoring (secondary preferences, evaluated on labelled placements) ───────
#   4 per cramped pair (unconnected parts crowded in the same half)
#   2 per pair in different halves
#   1 per column of distance from the centre (column 9)

shares_net (pl _ _ _ A1 B1 _ _ _ _ _ _ _ _) (pl _ _ _ A2 B2 _ _ _ _ _ _ _ _) <-
  (A1 == A2 ; A1 == B2 ; B1 == A2 ; B1 == B2).

pair_cost P1 P2 C <-
  P1 = pl _ _ _ _ _ _ _ Col1 H1 _ _ _ _,
  P2 = pl _ _ _ _ _ _ _ Col2 H2 _ _ _ _,
  (H1 == H2 -> Mixed = 0 ; Mixed = 2),
  D is abs (Col1 - Col2),
  ((H1 == H2, D <= 2, not (shares_net P1 P2)) -> Cramped = 4 ; Cramped = 0),
  C is Mixed + Cramped.

pairs_cost [] 0.
pairs_cost [P | T] C <- pairs_cost_with P T C1, pairs_cost T C2, C is C1 + C2.

pairs_cost_with _ [] 0.
pairs_cost_with P [Q | T] C <- pair_cost P Q C1, pairs_cost_with P T C2, C is C1 + C2.

centre_cost [] 0.
centre_cost [pl _ _ _ _ _ _ _ Col _ _ _ _ _ | T] C <- centre_cost T C1, C is C1 + abs (Col - 9).

score P Cost <- pairs_cost P C1, centre_cost P C2, Cost is C1 + C2.

# ─── Search: fewest jumpers, then narrowest window, then best score ──────────

windows [win 7 11, win 5 13, win 3 15, win 1 16].

best Cs Ns Wired Placement Cost <-
  multi_nets Cs Ns MNs, length MNs M,
  between 0 M K,
  choose K MNs Wired,
  windows Ws, member (win Lo Hi) Ws,
  minimize Cost (solve Cs Wired Lo Hi Placement, score Placement Cost),
  !.

# ─── Reporting ───────────────────────────────────────────────────────────────

row_letter 0 1 "a". row_letter 0 2 "b". row_letter 0 3 "c". row_letter 0 4 "d". row_letter 0 5 "e".
row_letter 1 1 "f". row_letter 1 2 "g". row_letter 1 3 "h". row_letter 1 4 "i". row_letter 1 5 "j".

hole_name Col Half Row S <- row_letter Half Row L, str_num CS Col, str_concat L CS S.

pin_label N Pin S <- atom_upper N NS, str_concat NS Pin S.

# nodes_of Net Placement Nodes: distinct node ids carrying pins of Net
nodes_of N P Nodes <-
  findall Node (member (pl _ _ _ A B _ _ _ _ _ _ NA NB) P, ((A == N, Node = NA) ; (B == N, Node = NB))) All,
  dedup All Nodes.

net_holes N P Hs <-
  findall H (member (pl _ _ _ A B _ R Col Half _ _ _ _) P,
             ((A == N, hole_name Col Half R H) ; (B == N, Col2 is Col + 1, hole_name Col2 Half R H))) Hs.

print_placement [].
print_placement [pl N K V _ _ _ R Col Half _ _ _ _ | T] <-
  atom_upper N NS, pad_right NS 6 NP,
  atom_upper K KS, pad_left V 6 VP,
  hole_name Col Half R Ha, Col2 is Col + 1, hole_name Col2 Half R Hb, pad_right Ha 5 HaP,
  write "  ", write NP, write "  (", write KS, write ", ", write VP, write ")   pin_a -> ", write HaP, write "  pin_b -> ", write Hb, nl,
  print_placement T.

print_nets [] _.
print_nets [N | T] P <-
  atom_upper N NS, pad_right NS 8 NP,
  net_holes N P Hs, join Hs ", " HS,
  nodes_of N P Nodes, length Nodes K,
  write "  ", write NP, write HS,
  (K > 1 -> J is K - 1, write "   <- WIRE NEEDED (", write J, write " jumper)" ; true), nl,
  print_nets T P.

print_wires Ns P <-
  findall N (member N Ns, nodes_of N P Nodes, length Nodes K, K > 1) Ws,
  (Ws == [] -> write "  none" , nl
   ; print_wire_list Ws).

print_wire_list [].
print_wire_list [N | T] <- atom_upper N NS, write "  Jumper on net ", write NS, nl, print_wire_list T.

print_sources Circuit <-
  findall (s N K V A B) (source Circuit N K V A B) Ss,
  (Ss == [] -> true ; write "  Sources (not placed): ", print_source_list Ss, nl).

print_source_list [].
print_source_list [s N _ V A B | T] <-
  atom_upper N NS, atom_upper A AS, atom_upper B BS,
  write NS, write " (", write V, write ") between ", write AS, write " and ", write BS, write "  ",
  print_source_list T.

# ─── ASCII board ─────────────────────────────────────────────────────────────

cell P Col Half Row S <-
  (member (pl N _ _ _ _ _ Row Col Half _ _ _ _) P -> pin_label N "a" S
   ; ColA is Col - 1, member (pl N _ _ _ _ _ Row ColA Half _ _ _ _) P -> pin_label N "b" S
   ; S = ".").

board_row P Half Row <-
  row_letter Half Row L, write "  ", write L, write " |",
  board_cells P Half Row 1, nl.

board_cells P Half Row Col <-
  Col <= 17, !,
  cell P Col Half Row S, pad_left S 4 SP, write SP, write " ",
  Col1 is Col + 1, board_cells P Half Row Col1.
board_cells _ _ _ _.

board_header <- write "    ", header_cols 1, nl.
header_cols Col <- Col <= 17, !, str_num S Col, pad_left S 5 SP, write SP, Col1 is Col + 1, header_cols Col1.
header_cols _.

board_rows _ _ 6 <- !.
board_rows P Half Row <- board_row P Half Row, Row1 is Row + 1, board_rows P Half Row1.

print_board P <-
  repeat_str "-----" 17 Sep,
  board_header, write "    ", write Sep, nl,
  board_rows P 0 1,
  nl, write "    ==== centre gap ====", nl, nl,
  board_rows P 1 1,
  write "    ", write Sep, nl, board_header.

# ─── Entry point ─────────────────────────────────────────────────────────────

run Circuit <-
  comps Circuit Cs, nets Cs Ns,
  write "=== Circuit ", write Circuit, write " ===", nl,
  print_sources Circuit,
  best Cs Ns _Wired P Cost,
  write "=== Placement (score ", write Cost, write ") ===", nl,
  print_placement P, nl,
  write "=== Nets ===", nl,
  print_nets Ns P, nl,
  write "=== Wires needed ===", nl,
  print_wires Ns P, nl,
  write "=== Breadboard (170-tie) ===", nl,
  print_board P, nl.

> run rc?
> run div?
> run tri?
