# ─── Jump Man: one set of predicates, four jobs ──────────────────────────────
#
# A level is a list of platforms `plat Id X Y` (Id 1..N, X to the right, Y up).
# Jump Man starts on platform 1 and wants the last platform.  A jump from one
# platform to another is possible when the horizontal gap is 1..3 and the
# landing is at most 2 higher or 4 lower.
#
# That rule, `jump_ok`, is written once with CLP(Z) and then used four ways:
#
#   verify    - is this platform sequence a legal route?   (all values known)
#   solve     - find routes, or the shortest route         (search over known level)
#   play      - simulate the run from a list of inputs     (one step at a time)
#   generate  - invent a level that is guaranteed solvable (values unknown; the
#               constraints prune the choices, a seeded shuffle picks among them)
#
# Load: infera examples/jumpman.nprolog
#   verify demo [1, 2, 4, 6]?          play demo [1, 3, 4, 6]?
#   routes demo?                        best demo?
#   show_level 7 42?                    once (generate 8 7 L), routes L?

<- notable.

# ─── Physics ─────────────────────────────────────────────────────────────────

max_dx 3.
max_up 2.
max_down 4.

# Works with numbers (checking) and with constraint variables (generating).
jump_ok (plat _ X1 Y1) (plat _ X2 Y2) <-
  max_dx MaxDx, max_up MaxUp, max_down MaxDown,
  DX #= X2 - X1, DX #>= 1, DX #<= MaxDx,
  DY #= Y2 - Y1, DY #<= MaxUp, DY #>= 0 - MaxDown.

# ─── Levels ──────────────────────────────────────────────────────────────────

demo [plat 1 0 0, plat 2 2 1, plat 3 3 3, plat 4 5 2, plat 5 6 5, plat 6 8 1].

start_of [plat Id _ _ | _] Id.
goal_of Level Id <- last Level (plat Id _ _).

reach Level A B <-
  member (plat A XA YA) Level, member (plat B XB YB) Level,
  jump_ok (plat A XA YA) (plat B XB YB).

# route Level From To Path: nondet when Path is unknown, a check when it is given.
route _ Goal Goal [Goal].
route Level From Goal [From | Path] <- reach Level From Next, route Level Next Goal Path.

# ─── Verify ──────────────────────────────────────────────────────────────────

verify Level Seq <-
  start_of Level S, goal_of Level G,
  (route Level S G Seq -> write "valid route" ; write "NOT a valid route"), nl.

# ─── Solve ───────────────────────────────────────────────────────────────────

routes Level <-
  start_of Level S, goal_of Level G,
  findall P (route Level S G P) Ps, length Ps N,
  write N, write " route(s):", nl, print_routes Ps.

print_routes [].
print_routes [P | Ps] <- write "  ", write P, nl, print_routes Ps.

best Level <-
  start_of Level S, goal_of Level G,
  minimize Len (route Level S G P, length P Len),
  write "shortest: ", write P, write " (", write Len, write " platforms)", nl.

# ─── Play ────────────────────────────────────────────────────────────────────
# Inputs are the platforms the player tries to jump to, in order.

play Level Inputs <-
  start_of Level S, goal_of Level G,
  print_level Level S,
  (Inputs = [S | Moves] -> true ; Moves = Inputs),
  run Level S G Moves.

run _ Cur Goal [] <-
  (Cur == Goal -> write "You reached the goal!" ; write "Stranded on platform ", write Cur), nl.
run Level Cur Goal [Next | Rest] <-
  (reach Level Cur Next ->
     write "jump ", write Cur, write " -> ", write Next, nl,
     print_level Level Next,
     run Level Next Goal Rest
   ; write "jump ", write Cur, write " -> ", write Next,
     write ": too far, Jump Man falls. GAME OVER", nl).

# ─── Generate ────────────────────────────────────────────────────────────────
# Each new platform gets constraint variables; jump_ok links it to the one
# before, so every generated level has at least one route by construction.
# A seeded shuffle decides which of the admissible gaps and heights to try.

generate N Seed [plat 1 0 0 | Rest] <-
  N > 1, Rest0 is N - 1, gen_plats Rest0 2 (plat 1 0 0) Seed Rest.

gen_plats 0 _ _ _ [].
gen_plats N Id Prev Seed [plat Id X Y | Rest] <-
  N > 0,
  X in 0..60, Y in 0..7,
  jump_ok Prev (plat Id X Y),
  next_seed Seed S1, next_seed S1 S2,
  shuffled S1 [1, 2, 3] Dxs, shuffled S2 [-4, -3, -2, -1, 0, 1, 2] Dys,
  Prev = plat _ PX PY,
  member DX Dxs, X #= PX + DX,
  member DY Dys, Y #= PY + DY,
  N1 is N - 1, Id1 is Id + 1,
  gen_plats N1 Id1 (plat Id X Y) S2 Rest.

show_level N Seed <-
  generate N Seed L, !, write "seed ", write Seed, write ": ", write L, nl,
  start_of L S, print_level L S.

# Linear congruential generator and a seeded shuffle.
next_seed Seed Next <- Next is (Seed * 1103515245 + 12345) % 2147483648.

shuffled _ [] [].
shuffled Seed Xs [Pick | Rest] <-
  length Xs Len, Idx is (Seed / 65536) % Len,
  nth Xs Idx Pick, remove_at Xs Idx Others,
  next_seed Seed S1, shuffled S1 Others Rest.

# ─── Rendering ───────────────────────────────────────────────────────────────

print_level Level Player <-
  findall X (member (plat _ X _) Level) Xs, max_list Xs W,
  findall Y (member (plat _ _ Y) Level) Ys, max_list Ys H,
  Top is H + 1,
  print_rows Level Player Top W, nl.

print_rows Level Player Row W <-
  Row >= 0, !,
  print_cells Level Player Row 0 W, nl,
  Next is Row - 1, print_rows Level Player Next W.
print_rows _ _ _ _.

print_cells Level Player Row X W <-
  X <= W, !,
  cell Level Player Row X C, write C,
  X1 is X + 1, print_cells Level Player Row X1 W.
print_cells _ _ _ _ _.

cell Level Player Row X C <-
  (member (plat Player X PY) Level, Row is PY + 1 -> C = "@"
   ; member (plat Id X Row) Level -> id_char Id C
   ; C = ".").

id_char Id C <- Id < 10, !, str_num C Id.
id_char Id C <- Code is Id - 10, nth ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k"] Code C.

# ─── List helpers ────────────────────────────────────────────────────────────

member X [X | _].
member X [_ | T] <- member X T.

length [] 0.
length [_ | T] N <- length T N1, N is N1 + 1.

last [X] X.
last [_ | T] X <- last T X.

nth [X | _] 0 X.
nth [_ | T] N X <- N > 0, N1 is N - 1, nth T N1 X.

remove_at [_ | T] 0 T.
remove_at [H | T] N [H | R] <- N > 0, N1 is N - 1, remove_at T N1 R.

max_list [X] X.
max_list [H | T] M <- max_list T MT, (H >= MT -> M = H ; M = MT).

# ─── Demo ────────────────────────────────────────────────────────────────────

> demo L, verify L [1, 2, 4, 6]?
> demo L, verify L [1, 3, 5, 6]?
> demo L, routes L?
> demo L, best L?
> demo L, play L [1, 2, 4, 6]?
> demo L, play L [3, 5]?
> show_level 7 7?
> show_level 7 42?
> show_level 7 99?
> once (generate 9 2024 L), routes L, best L?
