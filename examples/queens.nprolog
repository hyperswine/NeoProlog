# ─── N-queens ────────────────────────────────────────────────────────────────
#
# Place N queens on an N x N chessboard so that no two attack each other: no
# two share a row, a column or a diagonal.  A solution lists the column of the
# queen in each row, top row first, so [2, 4, 1, 3] is the board
#
#     . Q . .
#     . . . Q
#     Q . . .
#     . . Q .
#
# Every row holds one queen by construction, so a solution is a permutation of
# the columns 1..N whose queens are pairwise off-diagonal.  Three programs
# define the same relation; they differ in how early they reject a board:
#
#   queens_naive N Qs   generate every permutation, then test it (N! boards)
#   queens N Qs         place one row at a time, testing each queen as it is
#                       placed, so a bad prefix is never extended
#   queens_clp N Qs     post the rules as CLP(Z) constraints, then label;
#                       propagation removes attacked squares before each choice
#
# Run from the repository root:  infera examples/queens.nprolog

# Tabling is on by default for recursive predicates such as `place`, and a
# tabled call computes all of its answers before returning the first.  These
# predicates search through many different partial boards, so memoising them
# gains nothing; the whole file turns tabling off.
<- notable.

# The entry points: an integer in, a list of integers out, any number of
# answers.  Declared signatures are checked whenever these are called.
queens : nondet (int: <=) (list int: =>).
queens_naive : nondet (int: <=) (list int: =>).
queens_clp : nondet (int: <=) (list int: =>).
solutions : det (int: <=) (int: =>).
fundamentals : det (int: <=) (int: =>).

# ── Generate and test ────────────────────────────────────────────────────────

queens_naive N Qs <- numlist 1 N Cols, permutation Cols Qs, safe Qs.

# No queen attacks a queen in a later row.
safe [].
safe [Q | Qs] <- no_attack Q Qs 1, safe Qs.

# no_attack Q Qs D: the queen in column Q is off both diagonals of every queen
# in Qs, the first of which is D rows away.  Two queens D rows apart share a
# diagonal exactly when their columns are also D apart.
no_attack _ [] _.
no_attack Q [Q1 | Qs] D <-
  Gap is abs (Q - Q1), Gap != D,
  D1 is D + 1, no_attack Q Qs D1.

# ── One row at a time ────────────────────────────────────────────────────────

queens N Qs <- numlist 1 N Cols, place Cols [] Placed, reverse Placed Qs.

# place Free Placed Qs: Placed holds the queens placed so far, nearest row
# first, and Free the columns no queen uses yet.  Each new queen is checked
# against the placed ones before the next row is tried.
place [] Qs Qs.
place Free Placed Qs <-
  select Q Free Rest,
  no_attack Q Placed 1,
  place Rest [Q | Placed] Qs.

# ── Constraints ──────────────────────────────────────────────────────────────

queens_clp N Qs <-
  make_list N Qs,
  Qs in 1..N,
  all_different Qs,
  diagonals Qs,
  label Qs.

# Two queens D rows apart must not be D columns apart.  Each pair is posted
# with its offset as a constant, so a queen fixed by labeling removes exactly
# the squares it attacks from every other row.  Naming the diagonals with
# auxiliary variables U #= Q + I, D #= Q - I and posting all_different on Us
# and Ds prunes the same squares: an equality between two variables is
# domain-consistent, so a value all_different removes from U leaves Q's domain
# as well.  That encoding posts more constraints, and here it is a few times
# slower than the pairwise one at N = 60 while visiting the same boards.
diagonals [].
diagonals [Q | Qs] <- off_diagonal Q Qs 1, diagonals Qs.

off_diagonal _ [] _.
off_diagonal Q [Q1 | Qs] D <-
  Q #!= Q1 + D, Q #!= Q1 - D,
  D1 is D + 1, off_diagonal Q Qs D1.

make_list 0 [].
make_list N [_ | T] <- N > 0, N1 is N - 1, make_list N1 T.

# ── Counting and symmetry ────────────────────────────────────────────────────

solutions N Count <- findall Qs (queens N Qs) All, length All Count.

# The eight symmetries of the square, four rotations and four reflections, map
# solutions to solutions.  A solution is fundamental when it is the smallest of
# its images, so every symmetry class is counted once.
fundamental N Qs <-
  queens N Qs, images N Qs Images,
  forall (member Image Images) (lex_le Qs Image).

fundamentals N Count <- findall Qs (fundamental N Qs) All, length All Count.

# Mirroring, flipping and transposing generate all seven other images.
images N Qs [M, F, MF, T, MT, FT, MFT] <-
  mirror N Qs M, reverse Qs F, mirror N F MF,
  transpose N Qs T, mirror N T MT, reverse T FT, mirror N FT MFT.

# Left to right: column C becomes column N + 1 - C.
mirror _ [] [].
mirror N [Q | Qs] [M | Ms] <- M is N + 1 - Q, mirror N Qs Ms.

# In the main diagonal: the queen at row R, column C moves to row C, column R,
# so the image lists, for each column, the row of its queen.
transpose N Qs T <- numlist 1 N Cols, rows_of Cols Qs T.

rows_of [] _ [].
rows_of [C | Cs] Qs [R | Rs] <- row_of C Qs 1 R, rows_of Cs Qs Rs.

row_of C [C | _] R R.
row_of C [Q | Qs] I R <- Q != C, I1 is I + 1, row_of C Qs I1 R.

lex_le [] [].
lex_le [X | Xs] [Y | Ys] <- ( X < Y -> true ; X == Y, lex_le Xs Ys ).

# ── Lists ────────────────────────────────────────────────────────────────────

numlist Lo Hi [] <- Lo > Hi.
numlist Lo Hi [Lo | T] <- Lo <= Hi, Lo1 is Lo + 1, numlist Lo1 Hi T.

select X [X | T] T.
select X [H | T] [H | R] <- select X T R.

permutation [] [].
permutation L [H | T] <- select H L R, permutation R T.

member X [X | _].
member X [_ | T] <- member X T.

length [] 0.
length [_ | T] N <- length T N1, N is N1 + 1.

reverse L R <- reverse_onto L [] R.
reverse_onto [] R R.
reverse_onto [X | Xs] Acc R <- reverse_onto Xs [X | Acc] R.

# ── Drawing ──────────────────────────────────────────────────────────────────
# A board is a grammar for its own text; `emit` prints it.

board Qs -> { length Qs N }, board_rows Qs N.

board_rows [] _ -> [].
board_rows [Q | Qs] N -> squares 1 N Q, nl, board_rows Qs N.

squares C N _ -> { C > N }.
squares C N Q -> { C <= N, C1 is C + 1 }, ( { C == Q } -> "Q " ; ". " ), squares C1 N Q.

# Solution counts for every board size up to Max.
count_table Max -> "   N  solutions  fundamental", nl, count_rows 1 Max.

count_rows N Max -> { N > Max }.
count_rows N Max ->
  { N <= Max, solutions N S, fundamentals N F, N1 is N + 1 },
  padl N 4, padl S 11, padl F 13, nl,
  count_rows N1 Max.

# ── Demo ─────────────────────────────────────────────────────────────────────

> queens 6 Qs?
> once (queens 8 Qs), emit (board Qs)?
> queens_naive 6 Qs?
> solutions 8 N, fundamentals 8 F?
> emit (count_table 9)?
> once (queens_clp 8 Qs), emit (board Qs)?
> once (queens_clp 30 Qs)?
