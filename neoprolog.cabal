name:           neoprolog
version:        0.1.0.0
description:    NeoProlog — a Prolog-inspired logic programming language in Haskell
homepage:       https://github.com/hyperswine/neoprolog#readme
bug-reports:    https://github.com/hyperswine/neoprolog/issues
author:         Jasen Qin
maintainer:     jasen.qin33@gmail.com
copyright:      2025 Jasen Qin
license:        GPL-3
build-type:     Simple
cabal-version:  1.12
extra-source-files:
    README.md

source-repository head
  type: git
  location: https://github.com/hyperswine/neoprolog

library
  exposed-modules:
      NeoProlog
  other-modules:
      Paths_neoprolog
  hs-source-dirs:
      src
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , bytestring
    , containers
    , cryptohash-sha1
    , directory
    , filepath
    , haskeline
    , hedgehog
    , megaparsec
    , mtl
    , parser-combinators
    , prettyprinter
    , prettyprinter-ansi-terminal
    , text
  default-language: Haskell2010

executable neoprolog-exe
  main-is: Main.hs
  other-modules:
      Paths_neoprolog
  hs-source-dirs:
      app
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -O2 -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , neoprolog
  default-language: Haskell2010

test-suite neoprolog-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      NeoPrologTest
      Paths_neoprolog
  hs-source-dirs:
      test
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.7 && <5
    , containers
    , hedgehog
    , neoprolog
  default-language: Haskell2010
