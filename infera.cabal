tested-with:        GHC == 9.8.2

source-repository head
    type:     git
    location: https://github.com/hyperswine/NeoProlog.git

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints

library
    import:           warnings
    hs-source-dirs:   src
    default-language: Haskell2010
    exposed-modules:
        Infera
        Infera.Syntax
        Infera.Compile
        Infera.Compile.Cache
        Infera.Error
        Infera.Diagnostic
        Infera.Unify
        Infera.Machine.Heap
        Infera.Machine.Bridge
        Infera.Machine.Control
        Infera.Machine.CLP
        Infera.Machine.Table
        Infera.Machine.Tail
        Infera.Machine.Builtins
        Infera.Machine.Bytecode
        Infera.Machine.Trace
        Infera.Machine.Trace.Types
        Infera.Arith
        Infera.CLP
        Infera.Program
        Infera.Infer
        Infera.Purity
        Infera.Engine
        Infera.Engine.Reference
        Infera.Core
        Infera.Core.Store
        Infera.Core.Compile
        Infera.Core.Run
        Infera.Module
        Infera.Repl
    other-modules:    Infera.Engine.Contracts
    build-depends:
        base                        >= 4.14 && < 5,
        array                       >= 0.5 && < 0.6,
        bytestring                  >= 0.10,
        containers                  >= 0.6,
        cryptohash-sha1             >= 0.11,
        directory                   >= 1.3,
        filepath                    >= 1.4,
        haskeline                   >= 0.8,
        megaparsec                  >= 9.0,
        mtl                         >= 2.2,
        parser-combinators          >= 1.3,
        prettyprinter               >= 1.7,
        prettyprinter-ansi-terminal >= 1.1,
        text                        >= 1.2,
        transformers                >= 0.5 && < 0.7

executable infera
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    default-language: Haskell2010
    ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:
        base,
        infera

test-suite infera-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    InferaTest CorrectnessTest MinesweeperTest InferenceTest CoreTest
                      CLPPerformanceTest ReferenceCLP BreadboardTest TablingTest
                      MachineHeapTest MachineControlTest MachineSubsearchTest
                      MachineCLPTest MachineBreadboardTest
                      MachineTailTest
                      MachineReclaimTest
                      PerformanceDiagnosticTest
                      MachineStructuredTailTest
                      MachineBuiltinTest MachineTableTest MachineSnapshotTest
                      MachineGeneralTailTest MachineTailProofTest MachineTraceTest
                      MachineGraphReuseTest MachineEnvironmentTest MachineGeneralReclaimTest
                      MachineInternalTailTest
                      MachineNormalizeTest
                      CompileTest MachineBytecodeTest MachineBytecodeHeapTest MachineHeadTest
                      MachineLifetimeTest
                      MachineCompiledControlTest
                      MachineCacheTest
                      MachineOpaqueScopeTest
        MachineTypedBuiltinTest
        MachineOperandTest
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N1"
    build-depends:
        base,
        containers,
        directory,
        filepath,
        hedgehog   >= 1.7,
        infera

