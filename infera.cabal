cabal-version:      3.0
name:               infera
version:            2.0.0
synopsis:           Prolog-inspired logic language with sorts, modes, tabling and CLP(Z)
description:
    Infera is a Prolog-inspired logic programming language.  Predicates can
    declare (or have inferred) sorts, argument modes and determinism; the
    engine indexes and tables predicates by default, supports cut and
    if-then-else, a simple CLP(Z) solver, DCGs and a hash-addressed module
    system.
homepage:           https://github.com/hyperswine/NeoProlog
bug-reports:        https://github.com/hyperswine/NeoProlog/issues
license:            GPL-3.0-only
author:             Jasen Qin
maintainer:         jasen.qin33@gmail.com
copyright:          2025 Jasen Qin
category:           Language
build-type:         Simple
extra-doc-files:    README.md
extra-source-files: examples/*.nprolog test/cli.py
tested-with:        GHC == 9.8.2

source-repository head
    type:     git
    location: https://github.com/hyperswine/NeoProlog.git

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints

library
    import:           warnings
    hs-source-dirs:   src
    default-language: Haskell2010
    exposed-modules:
        Infera
        Infera.Syntax
        Infera.Error
        Infera.Diagnostic
        Infera.Unify
        Infera.Arith
        Infera.CLP
        Infera.Program
        Infera.Infer
        Infera.Engine
        Infera.Module
        Infera.Repl
    build-depends:
        base                        >= 4.14 && < 5,
        bytestring                  >= 0.10,
        containers                  >= 0.6,
        cryptohash-sha1             >= 0.11,
        directory                   >= 1.3,
        filepath                    >= 1.4,
        haskeline                   >= 0.8,
        megaparsec                  >= 9.0,
        mtl                         >= 2.2,
        parser-combinators          >= 1.3,
        prettyprinter               >= 1.7,
        prettyprinter-ansi-terminal >= 1.1,
        text                        >= 1.2

executable infera
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    default-language: Haskell2010
    ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:
        base,
        infera

test-suite infera-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    InferaTest CorrectnessTest MinesweeperTest
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:
        base,
        containers,
        directory,
        filepath,
        hedgehog   >= 1.7,
        infera
